{
  "extends": "../../mobile/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "react": [
        "../../mobile/node_modules/@types/react"
      ],
      "react/*": [
        "../../mobile/node_modules/@types/react/*"
      ],
      "react-native": [
        "../../mobile/node_modules/react-native/types_generated/index.d.ts"
      ],
      "@/*": [
        "../../mobile/src/*"
      ],
      "@/assets/*": [
        "../../mobile/assets/*"
      ]
    },
    "typeRoots": [
      "../../mobile/node_modules/@types"
    ]
  },
  "include": [
    "HouseViews.tsx",
    "../../mobile/src/types/expo.d.ts",
    "../../mobile/expo-env.d.ts"
  ]
}